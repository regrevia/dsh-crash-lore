{
  "name": "dsh-crash-lore",
  "version": "0.1.1",
  "description": "把 DSH 真实崩溃日志沉淀成精简约束，装插件前静态预检拦崩，起不来时受控自愈",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./core": "./core.mjs",
    "./guard": "./guard.mjs",
    "./cli": "./cli.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "crash-lore": "./cli.mjs"
  },
  "files": [
    "index.js",
    "core.mjs",
    "guard.mjs",
    "cli.mjs",
    "memory.mjs",
    "doctor.mjs",
    "rules.seed.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regrevia/dsh-crash-lore.git"
  },
  "homepage": "https://github.com/regrevia/dsh-crash-lore",
  "bugs": {
    "url": "https://github.com/regrevia/dsh-crash-lore/issues"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "crash",
    "preflight",
    "doctor"
  ],
  "author": {
    "name": "regrevia"
  }
}
