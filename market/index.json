  "plugins": [
    {
      "name": "dsh-crash-lore",
      "title": {
        "en": "Crash Lore",
        "zh": "崩溃防线"
      },
      "description": {
        "en": "Mines the host's real crash logs into 28 concise hard constraints, runs a 33-check static preflight on a plugin source directory before install (syntax, duplicate patch ids, ESM require, the tools.register output contract), quarantines a repeat crash culprit with a reversible backup, and hands a huge session over to a fresh one (the brief is written by a model that reads the original transcript; the original is archived, not deleted).",
        "zh": "把宿主真实崩溃日志沉淀成 28 条精简硬约束（事件回调必须自己兜住异常、一个必填配置缺失就起不来、client 入口没激活会让 boot 整体失败），装插件前对源码目录跑静态预检——33 项结构检查，含 node --check、patch 同 id 重复、ESM 里写 require、以及 tools.register 必须声明 output 的契约——宿主反复崩溃时用可撤销的备份隔离元凶，而不是手改 profile。目录干净退出码 0，有致命/起不来项退出码 1。还有「化龙妙法」：把大会话转世成新会话，交接单由模型读懂原会话后写，原会话归档可回看。"
      },
      "icon": "https://raw.githubusercontent.com/regrevia/dsh-crash-lore/main/icon.png",
